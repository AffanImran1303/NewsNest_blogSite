generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  category  String
  content   String
  image     String
  date      DateTime @default(now())
  published Boolean  @default(false)
}
